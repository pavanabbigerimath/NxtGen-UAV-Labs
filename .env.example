# ─────────────────────────── Database ───────────────────────────
# PostgreSQL connection string (Neon / Supabase / RDS / local docker)
DATABASE_URL="postgresql://uav:uav_password@localhost:5432/uav_labs?schema=public"
DIRECT_URL="postgresql://uav:uav_password@localhost:5432/uav_labs?schema=public"

# ─────────────────────────── NextAuth ───────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-32-byte-random-secret"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─────────────────── Rate limiting (Upstash Redis) ──────────────
# Optional. If omitted, an in-memory limiter is used automatically.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ─────────── File storage (AWS S3 — takes priority) ─────────────
# Optional. If omitted, Cloudinary is used; if that is omitted too,
# uploads fall back to local /public/uploads storage.
S3_REGION="us-east-1"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ENDPOINT=""

# ─────────── File storage (Cloudinary — fallback) ───────────────
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ─────────────────────────── Seeding ────────────────────────────
SEED_ADMIN_EMAIL="admin@uavlabs.io"
SEED_ADMIN_PASSWORD="Admin@12345"
SEED_ADMIN_NAME="Mission Control"
